#!/bin/bash
set -uo pipefail

REPO_PATH="${REPO_PATH:-/config}"
STATE_DIR="$REPO_PATH/.git-sync"
STATE_FILE="$STATE_DIR/state.json"
LOG_FILE="$STATE_DIR/watcher.log"
STOP_FILE="$STATE_DIR/stop"
SH="$REPO_PATH/ha-git-sync.sh"

cmd="${1:-help}"
arg1="${2:-}"

get_field() {
  [ -f "$STATE_FILE" ] || { echo ""; return; }
  grep -o "\"$1\"[^,]*" "$STATE_FILE" | head -1 | cut -d'"' -f4
}

get_pid() { get_field pid; }

is_alive() {
  local p="$1"
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

case "$cmd" in
  start)
    pid=$(get_pid)
    if is_alive "$pid"; then
      echo "Already running (PID=$pid)."
      exit 0
    fi
    rm -f "$STOP_FILE"
    nohup bash "$SH" >/dev/null 2>&1 &
    sleep 2
    pid=$(get_pid)
    if is_alive "$pid"; then
      echo "Started watcher (PID=$pid)."
    else
      echo "Watcher crashed at startup. Check: $LOG_FILE"
      exit 1
    fi
    ;;
  stop)
    pid=$(get_pid)
    if ! is_alive "$pid"; then echo "Not running."; exit 0; fi
    touch "$STOP_FILE"
    echo "Stop marker sent, waiting..."
    for i in $(seq 1 15); do
      sleep 1
      is_alive "$pid" || { echo "Stopped."; exit 0; }
    done
    echo "Graceful stop failed, kill -9 $pid..."
    kill -9 "$pid" 2>/dev/null || true
    ;;
  status)
    if [ ! -f "$STATE_FILE" ]; then
      echo "No state. Watcher never started."
      exit 0
    fi
    pid=$(get_pid)
    if is_alive "$pid"; then alive="yes"; else alive="no"; fi
    echo "=== Status ==="
    echo "PID:              $pid (alive: $alive)"
    echo "State:            $(get_field status)"
    echo "Started:          $(get_field started)"
    echo "Last change:      $(get_field lastChange)"
    echo "Last commit:      $(get_field lastCommit)"
    echo "Repo:             $(get_field repoPath)"
    echo "Branch:           $(get_field branch)"
    echo "Platform:         $(get_field platform)"
    ;;
  logs)
    n=20
    [ -n "$arg1" ] && [[ "$arg1" =~ ^[0-9]+$ ]] && n="$arg1"
    [ -f "$LOG_FILE" ] || { echo "No log."; exit 0; }
    tail -n "$n" "$LOG_FILE"
    ;;
  clearlogs)
    [ -f "$LOG_FILE" ] && : > "$LOG_FILE" && echo "Log cleared."
    ;;
  restart)
    "$0" stop; sleep 2; "$0" start
    ;;
  *)
    echo "Usage: git-sync <start|stop|status|logs|restart|clearlogs> [N]"
    ;;
esac
